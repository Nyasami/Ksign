    "Show your support by donating! If you're unable to donate, spreading the word works too!" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukažte svojí podporu díky podpoření! Pokud nemůžete podpořit, alespoň se o aplikaci podělte s ostatními!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montrez votre soutien en faisant un don!Si vous ne parvenez pas à faire un don, passer le mot fonctionne aussi!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thể hiện sự ủng hộ của bạn bằng cách quyên góp! Nếu bạn không thể quyên góp, việc chia sẻ cho người khác biết cũng có tác dụng!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeige deine Unterstützung, indem du Spendest! Wenn du nicht spenden kannst, das verteilen des Wortes funktioniert ebenfalls!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покажите свою поддержку, пожертвовав!Если вы не можете пожертвовать, распространение слова тоже работает!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
